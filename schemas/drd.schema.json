{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./drd.schema.json",
  "title": "Generic Data Requirements Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirement", "events"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goal"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "source": {"type": "string"}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "trigger", "platforms", "properties"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)+$"
        },
        "description": {"type": "string", "minLength": 1},
        "trigger": {"$ref": "#/$defs/trigger"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ios", "android", "web", "server", "other"]}
        },
        "owner": {"type": "string"},
        "legacy_event": {"type": ["string", "null"]},
        "source_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/property"}
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "valid_when", "counting", "boundary"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "valid_when": {"type": "string", "minLength": 1},
        "counting": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description", "privacy", "example"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "type": {
          "enum": ["string", "number", "boolean", "array", "object"]
        },
        "required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1},
        "privacy": {"enum": ["none", "low", "moderate", "high"]},
        "example": true,
        "enum": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "description"],
            "properties": {
              "value": {"type": ["string", "number", "boolean"]},
              "description": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
